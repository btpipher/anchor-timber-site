---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import CTAButtons from '../components/CTAButtons.astro';
import { siteConfig } from '../config/site';
---
<BaseLayout title="Services" description="Custom milling services from Pipher Forest Products in Crawford, Colorado.">
  <Section
    eyebrow="Services"
    title="Custom milling"
    subtitle="Call to confirm current services and scheduling."
  >
    <div class="grid grid-3">
      <Card
        title="Custom Milling"
        text="Lumber and timbers cut to requested dimensions."
      />
      <Card
        title="Surfacing & Planing"
        text="Surfacing for consistent thickness."
      />
      <Card
        title="Drying / Kiln Drying"
        text="Call to confirm current drying options."
      />
      <Card
        title="Specialty Cuts"
        text="Non-standard dimensions, long spans, and custom profiles."
      />
      <Card
        title="Delivery"
        text={`${siteConfig.serviceArea}. Confirm scheduling with your quote.`}
      />
    </div>
  </Section>

  <Section
    eyebrow="Process"
    title="Ordering"
  >
    <div class="grid grid-2">
      <Card title="1) Product" text="Tell us the product and species." />
      <Card
        title="2) Dimensions and quantity"
        text="Send dimensions, quantity, or a cut list."
      />
      <Card title="3) Price and timing" text="We confirm the price and lead time." />
      <Card title="4) Pickup or delivery" text="Arrange pickup in Crawford or delivery." />
    </div>
  </Section>

  <Section eyebrow="Quote" title="Request pricing" subtitle="Send the product, dimensions, and quantity.">
    <div class="cta-band">
      <div class="btn-group">
        <CTAButtons />
      </div>
    </div>
  </Section>
</BaseLayout>
