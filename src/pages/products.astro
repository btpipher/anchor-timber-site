---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import sawmill from '../content/sawmill.json';
import { siteConfig, withAsset, withBase } from '../config/site';

const otherProducts = [
  ['House logs', 'Available dimensions and species vary.'],
  ['Fence material', 'Posts, rails, planks, and other material.'],
  ['Rough-cut lumber', 'Cut to requested thickness, width, and length.'],
  ['Custom orders', 'Contact the mill with the species, dimensions, and quantity.'],
];
---

<BaseLayout title="Sawmill Products" description="Sawmill products from Pipher Forest Products in Crawford, Colorado.">
  <Section eyebrow="Sawmill" title="Products" subtitle="Call for current species, dimensions, pricing, and lead time.">
    <div class="catalog-list" data-live-products="sawmill:catalog">
      {sawmill.products.map((product) => (
        <article class="catalog-item">
          <img src={withAsset(product.image)} alt={product.imageAlt} loading="lazy" decoding="async" />
          <div>
            <p class="product-availability">{product.availability}</p>
            <h3>{product.name}</h3>
            <p>{product.description}</p>
          </div>
          <strong>{product.price}</strong>
        </article>
      ))}
    </div>
  </Section>

  <Section eyebrow="Other products" title="Also available">
    <div class="simple-list">
      {otherProducts.map(([name, description]) => (
        <article>
          <h3>{name}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </Section>

  <section class="home-cta">
    <div class="container home-cta-grid">
      <div>
        <p class="eyebrow">Quote</p>
        <h2>Send the product, dimensions, and quantity.</h2>
      </div>
      <div class="home-cta-action">
        <p>We will confirm material, price, and timing.</p>
        <div class="btn-group">
          <a class="btn btn-light" href={withBase('/quote')}>Request a quote</a>
          <a class="text-link" href={siteConfig.phoneHref}>{siteConfig.phone}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
