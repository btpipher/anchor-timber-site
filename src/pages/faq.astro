---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTAButtons from '../components/CTAButtons.astro';
import { siteConfig } from '../config/site';

const faqItems = [
  {
    question: 'What is Aspen tongue-and-groove and where is it used?',
    answer:
      'Aspen tongue-and-groove is an interior board with interlocking edges. It is commonly used on walls and ceilings.',
  },
  {
    question: 'What lengths/sizes can you do for T&G?',
    answer:
      'Available sizes and lengths vary. Call with the thickness, face width, length, and quantity you need.',
  },
  {
    question: 'Can you cut long beams (up to 40ft)?',
    answer:
      'Yes. We can mill beams and timbers up to 40ft, depending on species and availability.',
  },
  {
    question: 'What species do you mill?',
    answer:
      'Species availability changes. Call for current stock.',
  },
  {
    question: 'Can I bring my own logs?',
    answer:
      'Call the mill to confirm the logs, dimensions, and scheduling.',
  },
  {
    question: 'Typical lead times?',
    answer:
      `Lead times are typically ${siteConfig.leadTime}, with seasonal variation for large custom orders.`,
  },
  {
    question: 'Do you deliver?',
    answer:
      `Yes. ${siteConfig.serviceArea}; details confirmed during quoting.`,
  },
];
---
<BaseLayout title="FAQ" description="Frequently asked questions about Pipher Forest Products milling, Aspen T&G, and custom lumber.">
  <Section
    eyebrow="FAQ"
    title="Sawmill questions"
  >
    <FAQAccordion items={faqItems} />
  </Section>

  <Section eyebrow="Contact" title="Call or request a quote">
    <div class="cta-band">
      <div class="btn-group">
        <CTAButtons />
      </div>
    </div>
  </Section>
</BaseLayout>
