---
import BaseLayout from '../layouts/BaseLayout.astro';
import sawmill from '../content/sawmill.json';
import { siteConfig, withAsset, withBase } from '../config/site';

const capabilities = [
  ['Crawford, Colorado', 'Mill location'],
  ['Up to 40 feet', 'Beam length'],
  ['Made to order', 'Custom dimensions'],
  ['Western Slope', 'Pickup and delivery'],
];
---

<BaseLayout title={siteConfig.companyName} description={siteConfig.description}>
  <section class="home-hero">
    <div class="container home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow">Sawmill · Crawford, Colorado</p>
        <h1 data-live-text="sawmill.headline">{sawmill.headline}</h1>
        <p class="home-hero-lede" data-live-text="sawmill.intro">{sawmill.intro}</p>
        <div class="btn-group home-hero-actions">
          <a class="btn btn-primary" href={withBase('/products')}>View products</a>
          <a class="btn btn-outline" href={withBase('/quote')}>Request a quote</a>
        </div>
      </div>

      <figure class="home-hero-visual">
        <img
          src={withAsset(sawmill.heroImage)}
          alt={sawmill.heroImageAlt}
          width="4032"
          height="3024"
          loading="eager"
          fetchpriority="high"
          data-live-image="sawmill.heroImage"
          data-live-alt="sawmill.heroImageAlt"
        />
      </figure>
    </div>
  </section>

  <section class="capability-strip" aria-label="Mill information">
    <div class="container capability-grid">
      {capabilities.map(([value, label], index) => (
        <div class="capability" style={`--index: "0${index + 1}"`}>
          <strong>{value}</strong>
          <span>{label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="home-section product-showcase">
    <div class="container">
      <div class="home-section-heading compact-heading">
        <p class="eyebrow">Products</p>
        <h2>Sawmill products</h2>
        <p>Call for current species, sizes, lead times, and pricing.</p>
      </div>

      <div class="product-feature-grid" data-live-products="sawmill:home" data-detail-url={withBase('/products')}>
        {sawmill.products.map((product) => (
          <a class="product-feature" href={withBase('/products')}>
            <figure>
              <img src={withAsset(product.image)} alt={product.imageAlt} loading="lazy" decoding="async" />
            </figure>
            <div class="product-feature-copy">
              <div class="product-status">
                <span>{product.availability}</span>
                <span>{product.price}</span>
              </div>
              <h3>{product.name}</h3>
              <p>{product.description}</p>
              <span class="text-link">Details</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section feature-split">
    <div class="container feature-split-grid">
      <figure class="feature-split-image">
        <img
          src={withAsset('/images/aspen-tng/IMG_1988.jpeg')}
          alt="Aspen tongue-and-groove installed in a timber-framed building"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="feature-split-copy">
        <p class="eyebrow">Aspen T&amp;G</p>
        <h2>Aspen tongue-and-groove</h2>
        <p>Available for walls and ceilings in custom lengths and profiles.</p>
        <a class="btn btn-outline" href={withBase('/gallery')}>View photos</a>
      </div>
    </div>
  </section>

  <section class="home-cta">
    <div class="container home-cta-grid">
      <div>
        <p class="eyebrow">Orders</p>
        <h2>Send your dimensions and quantity.</h2>
      </div>
      <div class="home-cta-action">
        <p>We will confirm material, price, timing, pickup, or delivery.</p>
        <a class="btn btn-light" href={withBase('/quote')}>Request a quote</a>
      </div>
    </div>
  </section>
</BaseLayout>
